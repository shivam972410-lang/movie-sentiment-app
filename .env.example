# ==========================================
# CinePulse — Environment Configuration
# ==========================================

# FastAPI Backend Service URL (used by Streamlit frontend)
FASTAPI_URL=http://127.0.0.1:8000

# Server Listening Port (used when running main.py directly or on Render)
PORT=8000

# Decision Confidence Threshold (0.50 to 0.95, default 0.60)
# Predictions below this threshold are categorized as Neutral / Uncertain
CONFIDENCE_THRESHOLD=0.60

# ------------------------------------------
# Authentication (Login / Signup)
# ------------------------------------------

# REQUIRED in production: secret used to sign login tokens. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value. If unset, a temporary random key is used and
# everyone is logged out whenever the backend restarts.
JWT_SECRET_KEY=

# Database for user accounts. Leave empty for a local SQLite file (users.db).
# In production use PostgreSQL, e.g. postgresql://user:password@host:5432/dbname
# (free hosts such as Render erase local files on restart, which would delete SQLite accounts)
DATABASE_URL=

# Optional tuning
ACCESS_TOKEN_EXPIRE_MINUTES=60
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# BCRYPT_ROUNDS=12
# Comma-separated list of allowed browser origins (default: all)
# CORS_ORIGINS=https://your-app.streamlit.app

# ------------------------------------------
# Optional External API Integrations
# ------------------------------------------

# OMDb API Key for live movie metadata and plot fetching
# Get a free key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Google Gemini API Key for CineBot AI Chatbot
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
